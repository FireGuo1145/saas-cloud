{
  "name": "@mirelia/cloud",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -Apt run build",
    "dev": "cross-env NODE_ENV=development yumeri --import @hirarijs/loader/import start --auto-install",
    "start": "yumeri start --auto install"
  },
  "dependencies": {
    "@mirelia/project": "workspace:^",
    "yumeri": "^3.1.4"
  },
  "devDependencies": {
    "@hirarijs/loader": "^1.0.20",
    "@hirarijs/loader-ts": "^1.0.20",
    "@hirarijs/loader-tsx": "^1.0.0",
    "@types/node": "^26.6.6",
    "cross-env": "^10.0.0",
    "typescript": "^7.0.2"
  }
}
