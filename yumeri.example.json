{
  "core": {
    "host": "0.0.0.0",
    "port": 3000,
    "enableCors": false
  },
  "plugins": {
    "@mirelia/sqlite": {
      "path": "./data/mirelia.db"
    },
    "@mirelia/dashboard": {},
    "@mirelia/user": {
      "adminUsername": "",
      "adminEmail": "",
      "adminPassword": ""
    },
    "@mirelia/tenant": {},
    "@mirelia/project": {},
    "@mirelia/store": {
      "currency": "CNY",
      "cartItemLimit": 20,
      "purchaseEnabled": true
    },
    "@jpgpanel/server-instances": {
      "dockerSocket": "/var/run/docker.sock",
      "dataDir": "./data/instances",
      "portRangeStart": 30000,
      "portRangeEnd": 30999,
      "healthTimeoutSeconds": 180,
      "pullOnCreate": true
    },
    "@jpgpanel/file-manager": {
      "maxEditBytes": 2097152,
      "maxUploadBytes": 67108864,
      "hidden": [
        ".jar-name"
      ],
      "backupKeep": 10
    },
    "@jpgpanel/backup": {
      "intervalMinutes": 15,
      "onlyConfigured": true
    },
    "@jpgpanel/mc-instance": {},
    "@mirelia/auth": {
      "loginEnabled": true,
      "registrationEnabled": false
    },
    "@mirelia/rainyun": {
      "apiBaseUrl": "https://api.v2.rainyun.com",
      "apiKey": "",
      "timeoutMs": 12000
    },
    "@mirelia/billing": {
      "publicBaseUrl": "http://localhost:3001",
      "minimumTopUpCents": 100,
      "maximumTopUpCents": 500000,
      "manual": {
        "enabled": false,
        "instructions": "请向支付宝 13800000000（张三）转账 ¥{amount}，备注订单号 {orderId}。",
        "methods": [
          {
            "id": "alipay-manual",
            "label": "支付宝转账",
            "description": "工作日 10:00-18:00 人工确认",
            "imageUrl": "/api/static/asset/pay/alipay.png"
          }
        ]
      },
      "epay": {
        "enabled": false,
        "gatewayUrl": "",
        "pid": "",
        "key": ""
      }
    }
  }
}
